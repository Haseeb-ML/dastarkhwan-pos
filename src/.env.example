# Set these as actual environment variables. Defaults shown for local development.
ERP_PORT=5173
ERP_HOST=127.0.0.1
# ERP_DB is relative to this folder, or an absolute persistent path.
# Default: data/development.sqlite; production: data/production.sqlite.
ERP_DB=data/development.sqlite
ERP_SEED=1
ERP_PYTHON=python
ERP_SECURE=0
# NODE_ENV=production
# ERP_SETUP_TOKEN=<private random token, production initial setup only>
# ERP_FONT_ARABIC=<optional custom licensed Arabic TTF path>

